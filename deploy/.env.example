# Sparkbase install settings. Run ./generate-secrets.sh to fill the secrets.

# Base domain. DNS: app, api and s3 point at this server, plus *.db and *.cache.
SPARKBASE_DOMAIN=example.com

# Certificates: acme-http (default), acme-dns (wildcards, needs a DNS provider),
# custom (your files in traefik/certs), selfsigned (testing only).
TLS_MODE=acme-http
ACME_EMAIL=you@example.com
# acme-dns only: Traefik's provider name and its credentials, e.g.
# ACME_DNS_PROVIDER=cloudflare
# CF_DNS_API_TOKEN=...

# Bundled Traefik. Remove "traefik" to use your own (see docs/self-hosting.md).
COMPOSE_PROFILES=traefik

# Optional email (invites, password resets, limit warnings).
SMTP_URL=
MAIL_FROM=

# Image version to run.
SPARKBASE_VERSION=latest

# Secrets: generated, keep them safe. ENCRYPTION_KEY must be backed up with the
# control database; stored credentials cannot be decrypted without it.
ENCRYPTION_KEY=
TRAEFIK_CONFIG_TOKEN=
CONTROL_DB_PASSWORD=
CONTROL_REDIS_PASSWORD=
PG_HOST_PASSWORD=
PGBOUNCER_PASSWORD=
CACHE_HOST_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
