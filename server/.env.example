# Sparkbase server configuration. Copy to server/.env for `make run`.
SPARKBASE_DOMAIN=localhost
PUBLIC_API_URL=http://localhost:8787
DASHBOARD_URL=http://localhost:3000
PORT=8787

# Control plane (scripts/dev-services.sh starts these)
DATABASE_URL=postgres://sparkbase:sparkbase@127.0.0.1:54329/sparkbase?sslmode=disable
REDIS_URL=redis://:devredis@127.0.0.1:63799/0

# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret for Traefik's config endpoint and /metrics: openssl rand -hex 24
TRAEFIK_CONFIG_TOKEN=

# Without Traefik, native connection strings point straight at the hosts.
NATIVE_MODE=direct
TLS_MODE=none

# Bundled data hosts, registered on first start
BOOTSTRAP_PG_HOST=postgres://sb_admin:devadmin@127.0.0.1:54330/postgres
BOOTSTRAP_CACHE_HOST=redis://:devredis@127.0.0.1:63799
BOOTSTRAP_STORAGE=local:///absolute/path/to/sparkbase/.dev/storage
BACKUP_DIR=

# Optional: smtp://user:pass@host:587. Without it, emails are logged.
SMTP_URL=
MAIL_FROM=
LOG_LEVEL=info
