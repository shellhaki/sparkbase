# Postgres connection string used by the app, `migrate` and `export`.
DATABASE_URL=postgres://shellhaki@localhost:5432/sparkbase

# Secret salt for hashing IP addresses. Use a long random string, e.g. `openssl rand -hex 32`.
IP_HASH_SALT=

# Shown on /privacy and /unsubscribe. Required for production builds.
CONTACT_EMAIL=

# Public URL of the site, without a trailing slash. Used for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_GITHUB_URL=https://github.com/shellhaki
NEXT_PUBLIC_X_URL=https://x.com/haki_xer

# Optional. Set to your Plausible site domain (e.g. sparkbase.io) to enable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional. USD to NGN rate for the pricing currency switch. Defaults to 1500.
NEXT_PUBLIC_USD_TO_NGN=1500
